{
  // Standalone typecheck base: resolves core @deepseek-ai/dsh-* from the
  // published npm packages (their `exports` point at shipped .d.ts), and maps
  // the ONE in-repo package (@deepseek-ai/dsh-roundtable) to its source so
  // tool-roundtable / client-ui-roundtable typecheck without a prior build.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@deepseek-ai/dsh-roundtable": ["./packages/roundtable/roundtable/src/index.ts"],
      "@deepseek-ai/dsh-roundtable/*": ["./packages/roundtable/roundtable/src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  }
}
